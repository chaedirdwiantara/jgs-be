{
  "name": "jgs-be",
  "version": "1.0.0",
  "private": true,
  "description": "API for Jayanagiri EV Rental (jgs-ev.com) — rental applications, fleet, admin users and notifications.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
