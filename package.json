    "@aws-sdk/lib-dynamodb": "^3.918.0",
    "@aws-sdk/s3-presigned-post": "^3.918.0",
    "@aws-sdk/s3-request-presigner": "^3.918.0",
    "hono": "^4.9.10",
    "jose": "^6.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.5",
    "@types/aws-lambda": "^8.10.156",
    "@types/node": "^22.18.9",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
