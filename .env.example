# Local development only. In AWS every value below comes from the
# CloudFormation stack (see infra/template.yaml) — nothing is set by hand.
#
# Copy to `.env` and run `npm run dev`. The local server talks to the real
# tables named here, so point it at the ones you are willing to write to.

NODE_ENV=development
AWS_REGION=ap-southeast-1
PORT=3001
LOG_LEVEL=debug

TABLE_USERS=jgs-users
TABLE_APPLICATIONS=jgs-applications
TABLE_VEHICLES=jgs-vehicles
TABLE_NOTIFICATIONS=jgs-notifications
TABLE_RATE_LIMITS=jgs-rate-limits

DOCUMENTS_BUCKET=jgs-documents-121205961560

CORS_ORIGINS=http://localhost:3000,https://jgs-ev.com
CONSOLE_BASE_URL=http://localhost:3000

ACCESS_TOKEN_TTL_HOURS=8

# Names of the SSM parameters. Used when the direct values below are absent.
JWT_SECRET_PARAM=/jgs/prod/jwt-secret
TELEGRAM_BOT_TOKEN_PARAM=/jgs/prod/telegram-bot-token
TELEGRAM_CHAT_ID_PARAM=/jgs/prod/telegram-chat-id

# Direct overrides, for working offline from SSM. Never commit real values.
# JWT_SECRET=at-least-32-characters-of-random-text-here
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
